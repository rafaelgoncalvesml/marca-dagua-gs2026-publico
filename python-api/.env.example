# Estas variáveis ficam no terminal (ou no ambiente do servidor). Este arquivo só documenta os nomes.
# Não coloque valores reais aqui nem faça commit de um .env com valores.

# pares dispositivo:chave, separados por vírgula
MD_API_KEYS=
# chave de quem consulta o histórico (GET /leituras e /indicadores)
MD_READ_KEY=
# requisições por minuto de cada chave (padrão 60)
MD_LIMITE_POR_MINUTO=
# caminho do CSV (padrão data/leituras.csv)
MD_CSV_PATH=

# Só para os scripts cenarios.py e prova_protecao.py, na sua máquina
MD_API_KEY=
